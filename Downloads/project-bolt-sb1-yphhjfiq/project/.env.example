# LAVA LMS — frontend environment variables
# Copy to .env.local and fill in. Never commit .env.local.
#
# ONLY public values belong here. Anything prefixed with VITE_ is bundled
# into the browser JavaScript and is visible to every visitor.
#
# NEVER put the service-role key, a secret key (sb_secret_...), the JWT
# secret, or the database password in a VITE_ variable. Privileged keys live
# only in Supabase Edge Function secrets (managed by Supabase).

# Local:  run `npx supabase status` and copy "API URL" / "anon key"
# Hosted: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
